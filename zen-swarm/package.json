        "@langgraph-js/sdk": "^4.6.3",
        "@langgraph-js/standard-agent": "workspace:*",
        "@nanostores/react": "^1.0.0",
        "@trpc/client": "^11.10.0",
        "@trpc/server": "^11.10.0",
        "react": "^19.2.3",
