{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        // 项目引用配置
        "composite": true,

        // 生成声明映射（用于调试，可禁用以提升性能）
        "declarationMap": true,

        // 生成源映射（用于调试，可禁用以提升性能）
        "sourceMap": true,

        // 明确设置根目录和基础 URL
        "rootDir": "./src",
        "baseUrl": ".",
        "ignoreDeprecations": "5.0"
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
