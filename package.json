{
    "name": "code-graph",
    "author": "Your Name",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*",
        "zen-code",
        "zen-swarm",
        "zen-core"
    ],
    "scripts": {
        "dev:docs": "bunx --bun xyd-js@0.1.0-alpha.5",
        "dev:tui": "DEV=true bun --smol run zen-code/src/cli.ts",
        "devtool": "bunx react-devtools",
        "dev:core": "cd zen-core && bun run dev",
        "dev:swarm": " cd zen-swarm && bun run src/server.ts",
        "dev:all": "bun run dev:core & bun run dev:tui",
        "preview:tui": "node --expose-gc zen-code/dist/cli.js",
        "preview:bun": "bun run zen-code/dist/cli.js",
        "preview": "node --env-file=.env zen-code/dist/cli.mjs",
        "build": "bun run --filter './packages/*' build && bun run --filter zen-code build && bun run --filter zen-worker build",
        "build:packages": "bun run --filter './packages/*' build",
        "build:zen-code": "bun run --filter zen-code build",
        "build:zen-worker": "bun run --filter zen-worker build",
        "test": "bun test",
        "test:run": "bun test --run",
        "test:coverage": "bun test --coverage",
        "test:watch": "bun test --watch",
        "postinstall": "node scripts/patch-kysely.mjs",
        "prepare": "husky",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.78.0",
        "@langchain/anthropic": "^1.3.22",
        "@langchain/core": "^1.1.31",
        "@langchain/langgraph": "^1.1.0",
        "@langchain/mcp-adapters": "^1.1.1",
        "@langchain/openai": "^1.2.12",
        "@langgraph-js/pro": "^2.2.0",
        "@langgraph-js/pure-graph": "^3.3.0",
        "@langgraph-js/sdk": "^4.6.6",
        "eventemitter3": "^5.0.1",
        "execa": "^9.6.1",
        "glob": "^11.1.0",
        "hono": "^4.11.4",
        "langchain": "^1.1.1",
        "micromatch": "^4.0.0",
        "openai": "^6.16.0",
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "react-router-dom": "7.13.0",
        "uuid": "^13.0.0",
        "yaml": "^2.8.2",
        "zod": "^4.3.5"
    },
    "devDependencies": {
        "@types/bun": "^1.3.10",
        "@types/fs-extra": "^11.0.4",
        "@types/micromatch": "^4.0.10",
        "@types/node": "^20.19.30",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitest/coverage-v8": "^4.0.18",
        "@vitest/ui": "^4.0.18",
        "c8": "^10.1.3",
        "extract-zip": "^2.0.1",
        "fs-extra": "^11.3.3",
        "happy-dom": "^20.8.3",
        "husky": "^9.1.7",
        "lint-staged": "^15.4.3",
        "path-exists": "^5.0.0",
        "prettier": "^3.5.1",
        "react-devtools-core": "^7.0.1",
        "rollup-plugin-node-externals": "^8.1.2",
        "tempy": "^3.2.0",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "vitest": "^4.0.18",
        "xdg-basedir": "^5.1.0"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,json,md,yml,yaml}": "prettier --write"
    },
    "overrides": {
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "@langchain/core": "^1.1.31",
        "@langchain/langgraph": "^1.2.1",
        "langchain": "^1.2.30",
        "uuid": "^13.0.0",
        "execa": "^9.6.1",
        "@langgraph-js/pure-graph": "3.3.3"
    },
    "patchedDependencies": {
        "run-jxa@3.0.0": "patches/run-jxa@3.0.0.patch"
    }
}
