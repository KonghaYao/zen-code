{
    "name": "code-graph",
    "author": "Your Name",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*",
        "zen-code",
        "zen-swarm"
    ],
    "scripts": {
        "dev:docs": "bunx --bun xyd-js@0.1.0-alpha.5",
        "dev:server": "bun run ./packages/agent/src/server.ts",
        "dev:tui": "bun run zen-code/src/cli.ts",
        "dev:web": "cd zen-worker && bun run dev",
        "dev:all": "bun run --parallel dev:server dev:web",
        "dev": "bun run dev:server",
        "preview:bun": "bun run zen-code/dist/cli.mjs",
        "preview": "node --env-file=.env zen-code/dist/cli.mjs",
        "build": "bun run --filter './packages/*' build && bun run --filter zen-code build && bun run --filter zen-worker build",
        "build:packages": "bun run --filter './packages/*' build",
        "build:zen-code": "bun run --filter zen-code build",
        "build:zen-worker": "bun run --filter zen-worker build",
        "test": "bun test",
        "test:run": "bun test --run",
        "test:coverage": "bun test --coverage",
        "test:watch": "bun test --watch",
        "prepare": "husky",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.71.2",
        "@langchain/anthropic": "^1.3.18",
        "@langchain/core": "^1.1.26",
        "@langchain/langgraph": "^1.1.0",
        "@langchain/mcp-adapters": "^1.1.1",
        "@langchain/openai": "^1.2.2",
        "@langgraph-js/pro": "^2.2.0",
        "@langgraph-js/pure-graph": "^3.2.5",
        "@langgraph-js/sdk": "^4.6.3",
        "eventemitter3": "^5.0.1",
        "execa": "^9.6.1",
        "glob": "^11.1.0",
        "hono": "^4.11.4",
        "langchain": "^1.2.25",
        "micromatch": "^4.0.0",
        "openai": "^6.16.0",
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "uuid": "^13.0.0",
        "yaml": "^2.8.2",
        "zod": "^4.3.5"
    },
    "devDependencies": {
        "@types/bun": "^1.3.6",
        "@types/micromatch": "^4.0.10",
        "@types/node": "^20.19.30",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitest/coverage-v8": "^4.0.18",
        "@vitest/ui": "^4.0.18",
        "c8": "^10.1.3",
        "husky": "^9.1.7",
        "lint-staged": "^15.4.3",
        "prettier": "^3.5.1",
        "rollup-plugin-node-externals": "^8.1.2",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "vitest": "^4.0.18"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,json,md,yml,yaml}": "prettier --write"
    },
    "overrides": {
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "@langchain/core": "^1.1.26",
        "@langchain/langgraph": "^1.1.5",
        "langchain": "1.1.1"
    }
}
