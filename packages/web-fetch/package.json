{
    "name": "@langgraph-js/web-fetch",
    "version": "1.1.0",
    "type": "module",
    "description": "Web content extraction and parsing library with HTML-to-Markdown conversion",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "bun run bun.build.ts",
        "build:dev": "bun build ./src/cli.ts --outdir ./dist --target bun",
        "web-fetch": "bun ./dist/cli.js",
        "prepublishOnly": "bun run build"
    },
    "bin": {
        "web-fetch": "./dist/cli.js"
    },
    "dependencies": {
        "@mozilla/readability": "^0.6.0",
        "defuddle": "^0.11.0",
        "fetch-cookie": "^3.2.0",
        "iconv-lite": "^0.7.2",
        "tough-cookie": "^6.0.0",
        "turndown": "^7.2.0",
        "zod": "^4"
    },
    "devDependencies": {
        "@b-fuze/deno-dom": "npm:@jsr/b-fuze__deno-dom",
        "happy-dom": "^20.8.3"
    }
}
