{
    "name": "@langgraph-js/standard-agent",
    "version": "1.3.1",
    "type": "module",
    "description": "Standard Agent System - A unified agent package system for tools, middlewares, and storage",
    "main": "./dist/index.js",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "import": "./src/index.ts",
            "default": "./dist/index.js"
        },
        "./storage/sqlite": {
            "import": "./src/storage/sqlite.ts",
            "default": "./src/storage/sqlite.ts"
        }
    },
    "scripts": {
        "build": "vite build",
        "watch": "vite build --watch",
        "prepublishOnly": "bun run build",
        "test": "vitest run",
        "test:watch": "vitest watch",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@langchain/core": "^1",
        "@langchain/langgraph": "^1",
        "@langchain/mcp-adapters": "^1",
        "zod": "^4"
    },
    "devDependencies": {
        "@types/bun": "^1.3.9",
        "@types/node": "^20.19.30",
        "typescript": "^5.9.3",
        "vitest": "^4.0.18"
    }
}
