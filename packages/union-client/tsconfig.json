{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        // 项目引用配置
        "composite": true,

        // 生成声明映射（用于调试，可禁用以提升性能）
        "declarationMap": true,

        // 生成源映射（用于调试，可禁用以提升性能）
        "sourceMap": true,

        // 明确设置根目录和基础 URL
        "rootDir": "./src",
        "baseUrl": ".",

        // 引用其他包
        "paths": {
            "@codegraph/config": ["../config/src"],
            "@codegraph/ink-pro": ["../ink-pro/src"]
        }
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
